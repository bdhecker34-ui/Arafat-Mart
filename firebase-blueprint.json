{
  "entities": {
    "StoreContent": {
      "title": "StoreContent",
      "description": "Global store content, catalog, banners, contacts and configurations",
      "type": "object",
      "properties": {
        "banners": { "type": "array", "description": "Promotional banners and hero slides" },
        "products": { "type": "array", "description": "Catalog of active and archived products" },
        "categories": { "type": "array", "description": "Active product categories" },
        "notice": { "type": "object", "description": "Top announcement banner config" },
        "contact": { "type": "object", "description": "Payment numbers and contact channels" },
        "settings": { "type": "object", "description": "General store and delivery settings" },
        "coupons": { "type": "array", "description": "Discount vouchers and codes" },
        "updatedAt": { "type": "string", "description": "Last content update timestamp" }
      },
      "required": ["banners", "products", "categories", "contact", "settings"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order across Bangladesh 64 districts",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "description": "Unique order reference" },
        "customerName": { "type": "string", "description": "Customer full name", "maxLength": 100 },
        "customerPhone": { "type": "string", "description": "Customer mobile phone number", "maxLength": 20 },
        "deliveryDistrict": { "type": "string", "description": "Delivery district in Bangladesh", "maxLength": 50 },
        "deliveryAddress": { "type": "string", "description": "Street or village address", "maxLength": 300 },
        "paymentMethod": { "type": "string", "description": "Payment mode (bKash, Nagad, Rocket, COD)", "maxLength": 20 },
        "trxId": { "type": "string", "description": "Mobile transaction ID", "maxLength": 100 },
        "totalAmount": { "type": "number", "description": "Order total amount in BDT" },
        "status": { "type": "string", "description": "Current fulfillment status", "maxLength": 20 },
        "items": { "type": "array", "description": "Cart items in order" },
        "createdAt": { "type": "string", "description": "Order placement timestamp" }
      },
      "required": ["customerName", "customerPhone", "deliveryDistrict", "deliveryAddress", "paymentMethod", "totalAmount", "status"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrative user",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Admin email address", "maxLength": 100 },
        "role": { "type": "string", "description": "Access role", "maxLength": 30 },
        "createdAt": { "type": "string", "description": "Registration timestamp" }
      },
      "required": ["email", "role"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative actions audit log",
      "type": "object",
      "properties": {
        "action": { "type": "string", "description": "Action executed", "maxLength": 100 },
        "module": { "type": "string", "description": "System module", "maxLength": 50 },
        "detail": { "type": "string", "description": "Description of action", "maxLength": 500 },
        "adminEmail": { "type": "string", "description": "Email of admin who acted", "maxLength": 100 },
        "timestamp": { "type": "string", "description": "Log timestamp" }
      },
      "required": ["action", "adminEmail", "timestamp"]
    },
    "CustomerWish": {
      "title": "CustomerWish",
      "description": "Customer product wishlist submissions and requests",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Wish item title", "maxLength": 200 },
        "category": { "type": "string", "description": "Preferred product category", "maxLength": 50 },
        "expectedPrice": { "type": "string", "description": "Expected price or budget", "maxLength": 50 },
        "description": { "type": "string", "description": "Detailed wish notes", "maxLength": 1000 },
        "customerName": { "type": "string", "description": "Customer contact name", "maxLength": 100 },
        "customerPhone": { "type": "string", "description": "Customer mobile phone number", "maxLength": 20 },
        "customerEmail": { "type": "string", "description": "Customer email", "maxLength": 100 },
        "status": { "type": "string", "description": "Fulfillment status", "maxLength": 30 },
        "createdAt": { "type": "string", "description": "Submission timestamp" }
      },
      "required": ["title", "customerName", "customerPhone", "description", "status"]
    },
    "FeedPost": {
      "title": "FeedPost",
      "description": "User community posts with captions and postimages.org hosted photos",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "description": "Firebase Auth UID of post author", "maxLength": 128 },
        "authorName": { "type": "string", "description": "Display name of author", "maxLength": 100 },
        "authorAvatar": { "type": "string", "description": "Avatar image URL from postimages.org or placeholder" },
        "caption": { "type": "string", "description": "Text caption of the post", "maxLength": 3000 },
        "imageUrl": { "type": "string", "description": "Image URL strictly hosted on postimages.org" },
        "likes": { "type": "array", "description": "Array of user UIDs who liked the post" },
        "likesCount": { "type": "number", "description": "Total number of likes" },
        "commentsCount": { "type": "number", "description": "Total number of comments" },
        "status": { "type": "string", "description": "Post status (active/deleted)", "maxLength": 20 },
        "createdAt": { "type": "string", "description": "Post creation ISO timestamp" }
      },
      "required": ["authorId", "authorName", "caption", "status", "createdAt"]
    },
    "FeedComment": {
      "title": "FeedComment",
      "description": "Comments on community feed posts",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "description": "Target post ID", "maxLength": 128 },
        "authorId": { "type": "string", "description": "Comment author UID", "maxLength": 128 },
        "authorName": { "type": "string", "description": "Comment author name", "maxLength": 100 },
        "authorAvatar": { "type": "string", "description": "Comment author avatar URL" },
        "content": { "type": "string", "description": "Comment text", "maxLength": 1000 },
        "createdAt": { "type": "string", "description": "Comment ISO timestamp" }
      },
      "required": ["postId", "authorId", "authorName", "content", "createdAt"]
    },
    "CommunityProfile": {
      "title": "CommunityProfile",
      "description": "Public user profile with avatar from postimages.org and bio",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID", "maxLength": 128 },
        "displayName": { "type": "string", "description": "User display name", "maxLength": 100 },
        "avatarUrl": { "type": "string", "description": "Avatar URL from postimages.org" },
        "bio": { "type": "string", "description": "Short bio or tagline", "maxLength": 300 },
        "joinedAt": { "type": "string", "description": "Date user joined community" }
      },
      "required": ["userId", "displayName"]
    },
    "AffiliateAccount": {
      "title": "AffiliateAccount",
      "description": "User affiliate partner account with commission tracking and referral link",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the affiliate", "maxLength": 128 },
        "affiliateId": { "type": "string", "description": "Unique affiliate code (EM-AFF-XXXX)", "maxLength": 64 },
        "name": { "type": "string", "description": "Affiliate full name", "maxLength": 100 },
        "email": { "type": "string", "description": "Affiliate verified email", "maxLength": 100 },
        "status": { "type": "string", "description": "Account status (active/suspended)", "maxLength": 20 },
        "commissionRate": { "type": "number", "description": "Standard commission percentage" },
        "totalEarnings": { "type": "number", "description": "Lifetime confirmed earnings in BDT" },
        "balance": { "type": "number", "description": "Current withdrawable balance in BDT" },
        "pendingEarnings": { "type": "number", "description": "Pending delivery commissions in BDT" },
        "totalReferredOrders": { "type": "number", "description": "Count of successful referred orders" },
        "totalClicks": { "type": "number", "description": "Referral link clicks" },
        "payoutMethod": { "type": "string", "description": "Preferred payout gateway", "maxLength": 30 },
        "payoutNumber": { "type": "string", "description": "Mobile wallet or bank account number", "maxLength": 50 },
        "termsAccepted": { "type": "boolean", "description": "Agreement to affiliate terms and delivery policy" },
        "createdAt": { "type": "string", "description": "Affiliate registration timestamp" }
      },
      "required": ["userId", "affiliateId", "email", "status", "termsAccepted", "createdAt"]
    },
    "AffiliatePayout": {
      "title": "AffiliatePayout",
      "description": "Affiliate commission withdrawal request",
      "type": "object",
      "properties": {
        "payoutId": { "type": "string", "description": "Unique payout reference ID", "maxLength": 64 },
        "userId": { "type": "string", "description": "Affiliate UID", "maxLength": 128 },
        "affiliateId": { "type": "string", "description": "Affiliate code", "maxLength": 64 },
        "amount": { "type": "number", "description": "Withdrawal amount in BDT" },
        "paymentMethod": { "type": "string", "description": "Payment method (bKash/Nagad/Rocket)", "maxLength": 30 },
        "paymentNumber": { "type": "string", "description": "Account number for receiving funds", "maxLength": 50 },
        "status": { "type": "string", "description": "Payout status (pending/processed/rejected)", "maxLength": 20 },
        "createdAt": { "type": "string", "description": "Request creation timestamp" }
      },
      "required": ["payoutId", "userId", "affiliateId", "amount", "paymentMethod", "paymentNumber", "status", "createdAt"]
    }
  },
  "firestore": {
    "/store_content/{contentId}": {
      "schema": { "$ref": "#/entities/StoreContent" },
      "description": "Global store content, product inventory, banners, and settings"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders from across Bangladesh"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "System admin credentials and authorization record"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Chronological administrative action logs"
    },
    "/customer_wishes/{wishId}": {
      "schema": { "$ref": "#/entities/CustomerWish" },
      "description": "Customer wishlist submissions and product requests"
    },
    "/feed_posts/{postId}": {
      "schema": { "$ref": "#/entities/FeedPost" },
      "description": "Community posts with captions and postimages.org photos"
    },
    "/feed_comments/{commentId}": {
      "schema": { "$ref": "#/entities/FeedComment" },
      "description": "Comments on community feed posts"
    },
    "/user_profiles/{userId}": {
      "schema": { "$ref": "#/entities/CommunityProfile" },
      "description": "Public user profiles with postimages.org avatar"
    },
    "/affiliates/{userId}": {
      "schema": { "$ref": "#/entities/AffiliateAccount" },
      "description": "One-to-one user affiliate partner profile and commission records"
    },
    "/affiliate_payouts/{payoutId}": {
      "schema": { "$ref": "#/entities/AffiliatePayout" },
      "description": "Affiliate payout and withdrawal requests"
    }
  }
}
