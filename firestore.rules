rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (
        isSignedIn() && (
          request.auth.token.email == 'bdhecker34@gmail.com' ||
          request.auth.token.email == 'ashik140267@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
      );
    }

    // 1. Store Content (Catalog, Banners, Categories, Settings)
    match /store_content/{contentId} {
      // Storefront can read catalog and settings
      allow get, list: if isValidId(contentId);
      // Only authenticated admin can modify store content
      allow write: if isValidId(contentId) && isAdmin();
    }

    // 2. Orders (Customers submit orders, Admin manages fulfillment, Customer reads their own orders)
    match /orders/{orderId} {
      // Anyone can place a new order (validated payload)
      allow create: if isValidId(orderId) &&
        incoming().customerName is string && incoming().customerName.size() <= 100 &&
        incoming().customerPhone is string && incoming().customerPhone.size() <= 20 &&
        incoming().deliveryDistrict is string && incoming().deliveryDistrict.size() <= 50 &&
        incoming().deliveryAddress is string && incoming().deliveryAddress.size() <= 300 &&
        incoming().totalAmount is number && incoming().totalAmount >= 0;

      // Admin has full control; signed-in user can read their own orders
      allow read: if isValidId(orderId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow update, delete: if isValidId(orderId) && isAdmin();
    }

    // 3. Customer User Profiles
    match /users/{userId} {
      allow read, write: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
    }

    // 4. Admin Users
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId) && isAdmin();
    }

    // 5. Audit Logs
    match /audit_logs/{logId} {
      allow read: if isValidId(logId) && isAdmin();
      allow create: if isValidId(logId) && isAdmin();
    }

    // 6. Customer Wishes & Product Requests
    match /customer_wishes/{wishId} {
      // Anyone can submit a wish (with payload validation)
      allow create: if isValidId(wishId) &&
        incoming().title is string && incoming().title.size() <= 200 &&
        incoming().customerName is string && incoming().customerName.size() <= 100 &&
        incoming().customerPhone is string && incoming().customerPhone.size() <= 20 &&
        incoming().description is string && incoming().description.size() <= 1000;

      // Admin has full read and write access; signed-in user can read their own submissions
      allow read: if isValidId(wishId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow update, delete: if isValidId(wishId) && isAdmin();
    }

    // 7. Community Feed Posts
    match /feed_posts/{postId} {
      // Anyone can read community posts
      allow read: if isValidId(postId);
      // Only signed-up / authenticated users can create posts
      allow create: if isValidId(postId) && isSignedIn() &&
        incoming().authorId == request.auth.uid &&
        incoming().caption is string && incoming().caption.size() <= 3000;
      // Users can toggle likes / updates; Admin has full control
      allow update: if isValidId(postId) && (isAdmin() || isSignedIn());
      // Admin or post author can delete
      allow delete: if isValidId(postId) && (isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid));
    }

    // 8. Community Feed Comments
    match /feed_comments/{commentId} {
      // Anyone can read comments
      allow read: if isValidId(commentId);
      // Only authenticated users can write comments
      allow create: if isValidId(commentId) && isSignedIn() &&
        incoming().authorId == request.auth.uid &&
        incoming().content is string && incoming().content.size() <= 1000;
      // Admin or comment author can delete
      allow delete: if isValidId(commentId) && (isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid));
    }

    // 9. Public User Profiles (Avatar & Bio)
    match /user_profiles/{userId} {
      // Anyone can visit and view user profiles
      allow read: if isValidId(userId);
      // Only profile owner or admin can update avatar and profile info
      allow write: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
    }
  }
}
